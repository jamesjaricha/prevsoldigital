[Unit]
Description=Prevsol Digital website and client portal
Documentation=file:///home/prevsol/app/web/docs/OPERATIONS.md
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=prevsol
Group=prevsol
WorkingDirectory=/home/prevsol/app/web
EnvironmentFile=/home/prevsol/app/web/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm start

# Restart on failure, but back off so a crash loop does not hammer the box.
Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

# Hardening: the app only needs to read its own directory and reach the network.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/prevsol/app/web/.next
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=prevsol

[Install]
WantedBy=multi-user.target
